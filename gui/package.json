{
  "name": "seeenglish-gui",
  "private": true,
  "version": "0.6.0",
  "description": "SeeEnglish 见词 — 本地优先的英语语言索引",
  "author": "SeeEnglish",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
