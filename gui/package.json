    "dist:installer": "powershell -ExecutionPolicy Bypass -File ../packaging/build-installer.ps1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
